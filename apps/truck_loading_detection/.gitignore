# Large media and video files
*.mp4
!recorded_video/synchronized_normalized/*.mp4
*.avi
*.mov
*.mkv
*.webm
raw_4k_backup/
uploads/
scratch/
output_videos/

# Deep learning weights
*.pt
!best.pt
!yolo11n_carton_seg_best.pt
*.onnx
*.engine

# Temporary debug frames
*.jpg
*.png

# Environment secrets
.env

# Database files
*.db
*.sqlite3
*.db-wal
*.db-shm

# Python bytecode & cache
__pycache__/
*.py[cod]
*.log

# Allow configuration JSON files
!config/**/*.json
!config/*.json
