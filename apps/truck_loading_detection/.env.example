# Truck Loading Detection - Environment Configuration
# Copy this file to .env and customize for your deployment.

# Server
PORT=5000
HOST=0.0.0.0
WORKERS=1

# YOLO Detection
CONF_THRESHOLD=0.24
IOU_THRESHOLD=0.45
IMG_SIZE=640
FRAME_STRIDE=2
TORCH_THREADS=4

# RTSP / live camera resilience (warehouse CCTV)
RTSP_TRANSPORT=tcp
RTSP_STIMEOUT_MS=5000000
MAX_RECONNECT_ATTEMPTS=0
RECONNECT_BACKOFF_BASE=1.0
RECONNECT_BACKOFF_CAP=10.0
FRAME_DROP_MAX_CONSECUTIVE=30

# Stream
# Set to an RTSP URL for live camera feeds:
# VIDEO_SOURCE=rtsp://admin:password@192.168.1.100:554/stream1
VIDEO_SOURCE=

# Upload & Encoding
MAX_UPLOAD_MB=500
JPEG_QUALITY=70
