# ==============================================================================
# Face Authorization Service (App 3) - Environment Configuration Template
# ==============================================================================

# Server Ports
PORT=8003
HTTPS_PORT=8445

# Storage & Database
DATA_DIR=/app/data
SQLITE_DB_PATH=/app/data/face_auth.db

# Vector Database (Self-Hosted Qdrant)
QDRANT_URL=http://face_auth_qdrant:6333
QDRANT_COLLECTION=face_embeddings
VECTOR_DIM=512

# AI Face Sensitivity, Speed & Distance Tuning
DETECTOR_BACKEND=yunet
COSINE_THRESHOLD=0.62
REJECT_CEILING=0.72
MIN_FACE_SIZE=16
DETECTION_CONFIDENCE=0.45
LIVENESS_THRESHOLD=0.30
ENABLE_ANTI_SPOOF=true
STREAM_FPS=25
USB_WIDTH=640
USB_HEIGHT=480

# CCTV Camera & DHCP Failover Configuration
# Comma-separated list of known fallback IPs if DVR changes DHCP lease
CAMERA_DEFAULT_SOURCE=rtsp
CCTV_FAILOVER_IPS=192.168.1.100,192.168.1.101
DEFAULT_CAMERA_RTSP=rtsp://username:password@camera_ip:554/cam/realmonitor?channel=1&subtype=0

# Security & API Protection
FACE_AUTH_API_KEY=your-secure-random-token-here
REQUIRE_AUTH=false

# Streamlit Dashboard Connection
FASTAPI_URL=http://face-authorization:8003
