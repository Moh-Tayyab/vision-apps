# ==============================================================================
# Face Authorization Service (App 3) - Environment Configuration
# ==============================================================================

# Server Ports
PORT=8003
HTTPS_PORT=8445

# Network / LAN Discovery (Optional, auto-detected if left empty)
LAN_IP=192.168.1.39

# Storage & Database
DATA_DIR=data
SQLITE_DB_PATH=data/face_auth.db

# Vector Database (Self-Hosted Qdrant in Docker or Local)
# In Docker Compose, use: http://qdrant:6333
# In Local standalone, use: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=face_embeddings
VECTOR_DIM=512

# AI Face Sensitivity & Distance Tuning
COSINE_THRESHOLD=0.48
MIN_FACE_SIZE=14
DETECTION_CONFIDENCE=0.22
LIVENESS_THRESHOLD=0.50

# Security & API Protection
FACE_AUTH_API_KEY=face-auth-dev-key-2026
REQUIRE_AUTH=false

# Streamlit Dashboard Connection
FASTAPI_URL=http://localhost:8003
