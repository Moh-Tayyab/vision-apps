# Carton Counter configuration
PORT=8010

# --- Model backend: "local" | "roboflow" | "roboflow_workflow" ---
MODEL_BACKEND=roboflow_workflow

# Backend: local (ultralytics on-device)
MODEL_PATH=models/yolo26n.pt
CONF_THRESHOLD=0.5

# Backend: roboflow (single hosted model, full-image inference)
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_MODEL_URL=https://detect.roboflow.com/carton-counter-demo/5
# CONF_THRESHOLD=0.07

# Backend: roboflow_workflow (SAHI sliced inference - best accuracy)
# Workflow: Image Slicer 640px/25% overlap -> carton-counter-demo/5 -> NMS stitch
ROBOFLOW_WORKSPACE=muhammad-tayyab-iqnwv
ROBOFLOW_WORKFLOW=carton-counter-sahi
ROBOFLOW_WORKFLOW_OUTPUT=stitched_predictions
# Workflow returns all detections >=0.01; app filters client-side:
CONF_THRESHOLD=0.11

# Live stream
VIDEO_SOURCE=0
STREAM_FPS=30
