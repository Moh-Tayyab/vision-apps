# Carton Counter configuration
PORT=8010

# --- Model backend: "roboflow" | "local" | "roboflow_workflow" ---
# RECOMMENDED: roboflow (hosted RF-DETR v7, trained on 1051-image merged dataset)
#   mAP@50=97.9 | count error 8.1% on GT set | ~1s/call
MODEL_BACKEND=roboflow

ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_MODEL_URL=https://detect.roboflow.com/carton-counter-demo/7
CONF_THRESHOLD=0.36

# Backend: local (ultralytics on-device; offline fallback, generic boxes only)
# MODEL_BACKEND=local
# MODEL_PATH=models/yolo26n.pt

# Backend: roboflow_workflow (SAHI slicing - legacy, use for very dense scenes)
# ROBOFLOW_WORKSPACE=muhammad-tayyab-iqnwv
# ROBOFLOW_WORKFLOW=carton-counter-sahi
# ROBOFLOW_WORKFLOW_OUTPUT=stitched_predictions
# CONF_THRESHOLD=0.11

# Live stream
VIDEO_SOURCE=0
STREAM_FPS=30
