# ---------------------------------------------------------------------------
# Phase 4 — Example Production Environment (.env.example)
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in values for your deployment.
#
# SECURITY: `.env` must NOT be committed to version control. Never store
# production secrets here; inject them via Docker secrets, a secrets manager,
# or a protected, non-committed file at runtime.
#
# The carton counter uses the frozen local model (apps/truck_loading_detection
# /best.pt). It does NOT call Roboflow; ROBOFLOW_* vars below are only relevant
# to other services and are shown as placeholders.

# ---- Runtime (required) ----
PORT=5000
HOST=0.0.0.0
WORKERS=1
TORCH_THREADS=4

# ---- Certified Phase 3.3 active configuration (preserved, not tuned) ----
# Detection threshold τ_det = 0.15   Consensus threshold τ_cons = 0.25
CONF_THRESHOLD=0.15
CARTON_CONSENSUS_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMG_SIZE=640
FRAME_STRIDE=2
MAX_UPLOAD_MB=500
JPEG_QUALITY=70

# ---- Video source (RTSP URL or file path under /app/recorded_video) ----
VIDEO_SOURCE=output_videos/multi_angle_3angle_v2.mp4

# ---- Database persistence (SQLite WAL) ----
# Persist to a mounted volume in production (/app/data).
EVENT_STORE_DB_PATH=/app/data/carton_events.db
CARTON_EVENTS_DB_PATH=/app/data/carton_events.db

# ---- Inventory isolation guard (shadow mode) ----
AUTHORITATIVE_INVENTORY_LOCKED=true

# ---- CORS (comma-separated trusted origins; never "*" in production) ----
CORS_ORIGIN=localhost,127.0.0.1

# ---- Build / version identification (set at build time) ----
BUILD_VERSION=1.0.0
MODEL_VERSION=98c6164c

# ---- Roboflow (placeholders only; used by other services, not carton counter) ----
# Replace with your own values via a secrets manager; do NOT commit real keys.
MODEL_BACKEND=roboflow
ROBOFLOW_API_KEY=REPLACE_ME_WITH_YOUR_ROBOFLOW_API_KEY
ROBOFLOW_MODEL_URL=https://detect.roboflow.com/carton-counter-demo/7
